# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. Every value below is a DEVELOPMENT PLACEHOLDER: never use
# these in a shared or production environment.

ENV=development
DEBUG=false
APP_VERSION=dev
LOG_LEVEL=INFO
# json (production) or console (human-readable)
LOG_FORMAT=json

# At least 32 random bytes. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_FILE=/run/secrets/jwt_secret is also supported instead.
JWT_SECRET=dev-only-insecure-jwt-secret-replace-me-0000000000
# JWT_SECRET_PREVIOUS=

# false is accepted only when ENV=development (local HTTP).
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
# Proxies whose X-Forwarded-For is trusted (uvicorn --forwarded-allow-ips).
TRUSTED_PROXIES=127.0.0.1

# Database passwords. They are placed inside connection URLs, so keep them URL-safe
# (letters, digits, - and _). Changing them later requires `docker compose down -v`,
# because Postgres only reads them when it initializes an empty data volume.
# Owner (superuser, migrations only):
POSTGRES_OWNER_PASSWORD=dev-only-owner-password
# Application role (DML only, used by the API):
CHAT_APP_PASSWORD=dev-only-app-password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
