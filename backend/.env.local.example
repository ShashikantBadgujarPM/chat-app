# Settings for running the backend natively (no Docker), e.g. against a local
# PostgreSQL. Copy to backend/.env.local; that file is git-ignored.
# Real environment variables override anything here. Development values only.

ENV=development
LOG_FORMAT=console
COOKIE_SECURE=false
JWT_SECRET=dev-only-insecure-jwt-secret-replace-me-0000000000

# The API connects as the DML-only app role; migrations and --reset use the owner.
DATABASE_URL=postgresql+asyncpg://chat_app:root@localhost:5432/chat
DATABASE_OWNER_URL=postgresql+psycopg://chat_owner:root@localhost:5432/chat

# Password given to the demo users created by `uv run python -m app.seed`.
# (App passwords must be at least 10 characters, so it can't be just "root".)
SEED_PASSWORD=rootpassword
